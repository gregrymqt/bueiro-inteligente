# ==============================================================================
# CONFIGURAÇÕES GERAIS DO PROJETO
# ==============================================================================
PROJECT_NAME=BueiroInteligente
VERSION=1.0.0
API_STR=/api/v1

# ==============================================================================
# CONEXÕES DE BANCO DE DADOS E CACHE
# ==============================================================================
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=localhost;Database=bueiro;Username=postgres;Password=mypassword
CONNECTIONSTRINGS__MIGRATIONSCONNECTION=Host=localhost;Database=bueiro;Username=postgres;Password=mypassword
CONNECTIONSTRINGS__REDIS=localhost:6379,abortConnect=false

# ==============================================================================
# AUTENTICAÇÃO E SEGURANÇA (JWT & MOBILE)
# ==============================================================================
# Chave secreta para assinatura dos tokens JWT (Recomendado mínimo de 32 caracteres)
SECRET_KEY=substitua_por_uma_chave_secreta_e_longa_de_producao_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Chave secreta interna do aplicativo (Deve bater com o do BuildConfig do Android)
APP_ID_SECRET=jZ3frultyGb5G84zX4en0naZDwIal2HuJi83fqgyPmAWjyXtoI5WzywycGvepQew7aEDtLCwZ0MBZy07tuvY8zcRif8iA5M5CcUTCrHgRMx8Hde8oATev72TGmNO0mnR

# ==============================================================================
# PERMISSÕES ADMINISTRATIVAS
# ==============================================================================
# Lista de e-mails administrativos (separados por vírgula) que recebem a Role Admin
EMAIL_USERS_ADMIN=admin@gregcompany.com,professor@fatec.sp.gov.br

# ==============================================================================
# INTEGRAÇÃO DE HARDWARE / TELEMETRIA (NODE-RED & ESP32)
# ==============================================================================
# Token que o Node-RED usará na Query String para autenticar no MonitoringController
HARDWARE_TOKEN=seu_token_secreto_do_bueiro_para_validacao_de_hardware

# ==============================================================================
# AUTENTICAÇÃO EXTERNA (GOOGLE OAUTH)
# ==============================================================================
GOOGLE_CLIENT_ID=seu_client_id_do_google_oauth.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_do_google_oauth
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:5173/oauth/callback

# ==============================================================================
# INTEGRAÇÃO COM PLANILHAS (ROWS API)
# ==============================================================================
ROWS__API__KEY=sua_rows_api_key_aqui
ROWS__BASE__URL=https://api.rows.com/v1
ROWS__SPREADSHEET__ID=seu_id_da_planilha_rows_aqui
ROWS__TABLE__ID=seu_id_da_tabela_rows_aqui

# ==============================================================================
# ASSINATURAS E PAGAMENTOS (MERCADO PAGO)
# ==============================================================================
MercadoPago__AccessToken=seu_access_token_aqui
MercadoPago__WebhookUrl=http://localhost:5037/api/v1/payment/webhook
MercadoPago__PublicKey=sua_public_key_aqui
MercadoPago__WebhookKey=sua_webhook_key_aqui
MercadoPago__PlanBackUrl=http://localhost:5173/planos/sucesso

# ==============================================================================
# ARMAZENAMENTO DE ARQUIVOS (SUPABASE)
# ==============================================================================
SUPABASE__URL=https://seu-id.supabase.co
SUPABASE__KEY=sua_supabase_key
USE__SUPABASE__STORAGE=false

# ==============================================================================
# CONFIGURAÇÕES DE REDE, CORS E SEGURANÇA
# ==============================================================================
# Origens permitidas pelo CORS (Separe por vírgulas as URLs do Frontend e do Ngrok se usar)
ALLOWED_ORIGINS=http://localhost:5173,https://7bb5-2804-14d-8e90-5783-b8be-bd16-18b8-979e.ngrok-free.app
ALLOWED_HOSTS=*
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false